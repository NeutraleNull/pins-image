#!/bin/bash
# =============================================================================
# PINS first-run wizard
# =============================================================================
# Runs once, as root, from /etc/profile.d/00-pins-firstrun.sh on the first
# interactive login of the appliance user. Four things, in this order:
#
#   1. make sure the shipped password is gone
#   2. network: keep the fallback hotspot, or join a Wi-Fi network
#   3. optionally rename the rig
#   4. show where the web UI now lives, and take itself out of the way
#
# Design rules that are not obvious from the code:
#
#   * Ctrl-C / Ctrl-Z / Ctrl-\ are ignored. Half-configured is the one state
#     this device must never be left in silently.
#   * Every step is idempotent and the flag file is removed LAST. Pull the
#     network cable in the middle and the next login starts over, with whatever
#     was already done still done.
#   * Wi-Fi is joined through pinsdaemon's wifi-connect.sh, never through bare
#     nmcli. wifi-connect.sh records the result in wifi_config.json and flips
#     desired_mode to "auto"; a connection made behind its back is torn down
#     again by the watchdog on its next run.
#   * The hotspot password is changed in hotspot_config.json, never with
#     `nmcli con modify`. The AP profile is regenerated from that file on every
#     fallback, so an nmcli edit would be gone after the next recovery.
#   * Passwords are only ever passed on stdin. Never a command line (visible in
#     /proc), never a file, never the journal.
# =============================================================================
set -uo pipefail
trap '' INT TSTP QUIT

TITLE="PINS setup"
FLAG=/var/lib/pins/firstrun
LOCK=/var/lib/pins/firstrun.lock
PINS_USER="${PINS_USER:-pins}"
SUDOERS=/etc/sudoers.d/pins-firstrun
HOTSPOT_CONFIG=/opt/pinsdaemon/app/hotspot_config.json
WIFI_CONNECT=/usr/local/bin/wifi-connect.sh
RIG_NAME_CMD=/usr/local/bin/pins-rig-name

# Already done: the hook still sources on every login until profile.d is gone,
# so this must be a cheap no-op afterwards.
[ -f "$FLAG" ] || exit 0
[ "$(id -u)" -eq 0 ] || { echo "must run as root"; exit 1; }

install -d -m 0755 /var/lib/pins
exec 9>"$LOCK"
if ! flock -n 9; then
    # Two logins at once. The second one must not race the first through
    # passwd/nmcli, so it says so and gets out of the way.
    whiptail --title "$TITLE" --msgbox \
        "Setup is already running in another session.\n\nFinish it there, then log in again." 10 60
    exit 0
fi
command -v whiptail >/dev/null || { echo "whiptail missing"; exit 1; }

HOTSPOT_PW_CHANGED=0
WIFI_JOINED=""

# --- small helpers -----------------------------------------------------------
# Every dialog that cannot be drawn returns non-zero, and the flow treats a
# cancelled dialog as "move on". Put those two together on a terminal that has
# gone away - a hung-up pty, TERM=dumb, a window too small for newt - and the
# wizard would sprint through all five steps in a second and delete its own flag
# without a single character reaching the operator. Measured on a test VM: the
# flag and the sudo rule were gone and the setup had never been shown.
#
# Two guards. This counter aborts once five dialogs in a row could not be shown,
# and step_summary only cleans up when the closing dialog really succeeded.
UI_FAILS=0
ui_account() {
    if [ "$1" -eq 0 ]; then
        UI_FAILS=0
    else
        UI_FAILS=$((UI_FAILS + 1))
        if [ "$UI_FAILS" -ge 5 ]; then
            echo "PINS setup: five dialogs in a row could not be displayed." >&2
            echo "Run 'sudo /usr/lib/pins/firstrun-wizard' from a real terminal." >&2
            # The flag and the sudo rule stay: the next login starts over.
            exit 1
        fi
    fi
    return 0
}
msgbox()  { whiptail --title "$TITLE" --msgbox "$1" "${2:-12}" "${3:-72}"; ui_account "$?"; }
has_wifi_hw() {
    nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2=="wifi"{print $1}' | grep -q .
}

hotspot_ssid() {
    # The SSID lives in pinsdaemon's hotspot_config.json. Fall back to the
    # documented default rather than to the hostname: on x64 the SSID is
    # deliberately decoupled from the rig name.
    local s=""
    if [ -f "$HOTSPOT_CONFIG" ] && command -v python3 >/dev/null 2>&1; then
        s="$(python3 - "$HOTSPOT_CONFIG" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        v = json.load(f).get("ssid")
    if isinstance(v, str) and v.strip():
        print(v.strip())
except Exception:
    pass
PY
)"
    fi
    printf '%s' "${s:-pinspot}"
}

# --- 1. welcome --------------------------------------------------------------
msgbox "Welcome to PINS.\n\
\n\
This short setup covers three things:\n\
  * a new password for the '${PINS_USER}' account\n\
  * the network: keep the built-in hotspot, or join your Wi-Fi\n\
  * optionally, a name for this rig\n\
\n\
Losing the connection here breaks nothing: setup starts again at the next\n\
login and everything already done stays done." 17 74

# --- 2. password (mandatory) -------------------------------------------------
step_password() {
    # chage -d 0 makes PAM force the change during the SSH login itself, i.e.
    # before this wizard is ever reached. Asking a second time there would be
    # pure noise, so the common case is a one-line acknowledgement.
    if ! chage -l "$PINS_USER" 2>/dev/null | grep -qi 'password must be changed'; then
        msgbox "Password already changed - good." 8 56
        : > /var/lib/pins/password-changed
        chmod 0644 /var/lib/pins/password-changed
        return 0
    fi

    # Still pending: a console login, or an install where chage never ran. Ask
    # here rather than shelling out to passwd -- passwd invoked BY ROOT skips
    # every quality check, so "pins" and other three-character passwords would
    # sail through. Cancel is not an option; this step is mandatory.
    local pw pw2 tries=0
    while :; do
        tries=$((tries + 1))
        if [ "$tries" -gt 10 ]; then
            # Never loop forever. The account keeps its "must change" flag, so
            # PAM asks again at the next login: safe, just not guided.
            msgbox "The password was not changed.\n\nYou will be asked again at the next login." 9 64
            return 0
        fi
        pw="$(whiptail --title "$TITLE" --passwordbox \
            "Choose a new password for the '${PINS_USER}' account.\n\nAt least 8 characters." \
            11 72 3>&1 1>&2 2>&3)" || { msgbox "The password has to be changed." 8 56; continue; }
        pw2="$(whiptail --title "$TITLE" --passwordbox "Repeat the password." 9 72 3>&1 1>&2 2>&3)" \
            || { msgbox "The password has to be changed." 8 56; continue; }
        if [ -z "$pw" ]; then
            msgbox "An empty password is not allowed." 8 56; continue
        fi
        if [ "${#pw}" -lt 8 ]; then
            msgbox "The password must be at least 8 characters long." 8 60; continue
        fi
        if [ "$pw" = "$PINS_USER" ]; then
            msgbox "The password must not be the same as the user name." 8 60; continue
        fi
        if [ "$pw" != "$pw2" ]; then
            msgbox "The two entries do not match." 8 56; continue
        fi
        # stdin only: never a command line, never a file.
        if printf '%s:%s\n' "$PINS_USER" "$pw" | chpasswd; then
            pw=""; pw2=""
            break
        fi
        msgbox "Password change failed. Please try again." 8 56
    done

    : > /var/lib/pins/password-changed
    chmod 0644 /var/lib/pins/password-changed
}

# --- 3. network --------------------------------------------------------------
set_hotspot_password() {
    local pw pw2
    while :; do
        pw="$(whiptail --title "$TITLE" --passwordbox \
            "New password for the hotspot '$(hotspot_ssid)'.\n\n8 to 63 characters (WPA2 limits)." \
            11 72 3>&1 1>&2 2>&3)" || return 1
        pw2="$(whiptail --title "$TITLE" --passwordbox "Repeat the password." 9 72 3>&1 1>&2 2>&3)" || return 1
        if [ "${#pw}" -lt 8 ] || [ "${#pw}" -gt 63 ]; then
            msgbox "A WPA2 password must be 8 to 63 characters long." 8 60
            continue
        fi
        if [ "$pw" != "$pw2" ]; then
            msgbox "The two entries do not match." 8 60
            continue
        fi
        break
    done

    if [ ! -d "$(dirname "$HOTSPOT_CONFIG")" ] || ! command -v python3 >/dev/null 2>&1; then
        msgbox "pinsdaemon is not installed here, so the hotspot password cannot be changed." 9 68
        return 1
    fi

    # Merge instead of overwrite: the file also carries the SSID and the band,
    # and dropping those would send the AP back to its upstream defaults.
    if ! python3 - "$HOTSPOT_CONFIG" "$pw" <<'PY'
import json, os, sys, tempfile
p, pw = sys.argv[1], sys.argv[2]
cfg = {}
if os.path.exists(p):
    try:
        with open(p, encoding="utf-8") as f:
            cfg = json.load(f)
    except Exception:
        cfg = {}
if not isinstance(cfg, dict):
    cfg = {}
cfg.update({"security": "wpa-psk", "password": pw})
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p))
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(cfg, f, indent=4)
os.chmod(tmp, 0o644)
os.replace(tmp, p)
PY
    then
        msgbox "Could not write the hotspot configuration." 8 60
        return 1
    fi
    # Back to the daemon: the API rewrites this file at runtime and cannot do so
    # if root has taken it over.
    chown sysupdate-api:sysupdate-api "$HOTSPOT_CONFIG" 2>/dev/null || true

    # Rebuild the AP so the new password is live without a reboot. Best effort:
    # on a device with no Wi-Fi adapter there is nothing to rebuild.
    [ -x "$WIFI_CONNECT" ] && "$WIFI_CONNECT" --hotspot >/dev/null 2>&1
    HOTSPOT_PW_CHANGED=1
    msgbox "Hotspot password changed.\n\nReconnect your phone or tablet with the new password." 10 68
    return 0
}

do_hotspot() {
    local sub
    sub="$(whiptail --title "$TITLE" --menu \
        "The device keeps its own Wi-Fi network '$(hotspot_ssid)' (WPA2).\n\
Connect a phone or tablet to it and open http://10.42.0.1:5000\n\
The hotspot hands out addresses but no default route, so the phone\n\
keeps using mobile data for the Internet." 16 74 2 \
        "keep"   "Keep the current password" \
        "change" "Change the hotspot password" 3>&1 1>&2 2>&3)" || return 1
    case "$sub" in
        keep)   return 0 ;;
        change) set_hotspot_password || return 1 ;;
    esac
    return 0
}

pick_ssid() {
    # nmcli -t escapes ':' inside values as '\:', so the fields cannot be split
    # on ':' naively. Parse it properly, drop empty SSIDs and keep the strongest
    # entry per SSID.
    python3 - <<'PY'
import subprocess, sys

def unescape(cell):
    out, esc = [], False
    for ch in cell:
        if esc:
            out.append(ch); esc = False
        elif ch == "\\":
            esc = True
        else:
            out.append(ch)
    return "".join(out)

def split_terse(line):
    fields, cur, esc = [], [], False
    for ch in line:
        if esc:
            cur.append("\\"); cur.append(ch); esc = False
        elif ch == "\\":
            esc = True
        elif ch == ":":
            fields.append("".join(cur)); cur = []
        else:
            cur.append(ch)
    if esc:
        cur.append("\\")
    fields.append("".join(cur))
    return [unescape(f) for f in fields]

try:
    raw = subprocess.run(
        ["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list"],
        capture_output=True, text=True, timeout=60).stdout
except Exception:
    sys.exit(0)

best = {}
for line in raw.splitlines():
    if not line.strip():
        continue
    parts = split_terse(line)
    if len(parts) < 2:
        continue
    ssid = parts[0].strip()
    if not ssid:
        continue
    try:
        signal = int(parts[1])
    except ValueError:
        signal = 0
    security = (parts[2] if len(parts) > 2 else "").strip() or "open"
    if ssid not in best or signal > best[ssid][0]:
        best[ssid] = (signal, security)

for ssid, (signal, security) in sorted(best.items(), key=lambda kv: -kv[1][0]):
    # tag <TAB> description -- the tag is the SSID itself.
    print(f"{ssid}\t{signal}% {security}")
PY
}

do_wifi() {
    if ! has_wifi_hw; then
        msgbox "No Wi-Fi adapter found on this device.\n\n\
Use the wired network, or plug in a USB Wi-Fi adapter and run\n\
'sudo /usr/lib/pins/firstrun-wizard' again." 11 70
        return 1
    fi

    whiptail --title "$TITLE" --infobox "Scanning for networks..." 7 50
    nmcli device wifi rescan >/dev/null 2>&1 || true
    sleep 3

    local -a menu=()
    local tag desc
    while IFS=$'\t' read -r tag desc; do
        [ -n "$tag" ] && menu+=("$tag" "$desc")
    done < <(pick_ssid)
    menu+=("__other__" "Other / hidden SSID...")

    local ssid
    ssid="$(whiptail --title "$TITLE" --menu "Which network should this device join?" \
        20 72 10 "${menu[@]}" 3>&1 1>&2 2>&3)" || return 1
    if [ "$ssid" = "__other__" ]; then
        ssid="$(whiptail --title "$TITLE" --inputbox "Network name (SSID):" 9 72 3>&1 1>&2 2>&3)" || return 1
        [ -n "$ssid" ] || { msgbox "No network name given." 8 50; return 1; }
    fi

    local pw
    pw="$(whiptail --title "$TITLE" --passwordbox \
        "Password for '$ssid'.\n\nLeave empty for an open network." 10 72 3>&1 1>&2 2>&3)" || return 1

    if [ ! -x "$WIFI_CONNECT" ]; then
        msgbox "pinsdaemon is not installed here, so Wi-Fi cannot be configured." 9 68
        return 1
    fi

    whiptail --title "$TITLE" --infobox \
        "Connecting to '$ssid'.\n\nThis can take up to a minute." 8 60
    # /run, not /tmp: tiny file, root-only, gone at the next boot either way.
    local out; out="$(mktemp /run/pins-wizard.XXXXXX)"
    local rc=0
    printf '%s\n' "$pw" | "$WIFI_CONNECT" --password-stdin --auto-connect yes "$ssid" >"$out" 2>&1 || rc=$?
    pw=""

    if [ "$rc" -eq 0 ]; then
        local addrs; addrs="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -v '^$' | paste -sd' ' -)"
        WIFI_JOINED="$ssid"
        rm -f "$out"
        msgbox "Connected to '$ssid'.\n\nAddresses: ${addrs:-unknown}\n\n\
The hotspot switches itself off while this network is reachable and comes\n\
back automatically if it disappears." 13 74
        return 0
    fi

    # wifi-connect.sh/pins-wifi-profile.py print a machine-readable result line.
    # Showing the code makes a support request answerable.
    local code; code="$(grep -o 'code=[^ ]*' "$out" 2>/dev/null | tail -1)"
    local why;  why="$(sed -n 's/.*message=//p' "$out" 2>/dev/null | tail -1)"
    rm -f "$out"
    msgbox "Could not join '$ssid'.\n\n${code:-exit=$rc}\n${why:-Check the password and the network name.}\n\n\
The hotspot is already back up, so this device stays reachable." 14 74
    return 1
}

step_network() {
    local choice
    while :; do
        choice="$(whiptail --title "$TITLE" --menu "How should this device reach the network?" \
            15 74 3 \
            "hotspot" "Keep hotspot (recommended for field use)" \
            "wifi"    "Connect to a Wi-Fi network" \
            "skip"    "Skip for now" 3>&1 1>&2 2>&3)" || return 0
        case "$choice" in
            hotspot) do_hotspot && return 0 ;;
            wifi)    do_wifi    && return 0 ;;
            skip)    return 0 ;;
            *)       return 0 ;;
        esac
        # Anything that returned non-zero (cancel, failed join) lands back in
        # the menu instead of dropping the operator into a half-set-up device.
    done
}

# --- 4. rig name (optional) --------------------------------------------------
step_rigname() {
    local cur new name
    cur="$(cat /etc/pins/rig-name 2>/dev/null || hostname)"
    cur="${cur:-pins}"
    new="$(whiptail --title "$TITLE" --inputbox \
        "Name for this rig. It becomes the hostname and the mDNS name\n\
'<name>.local'. Leave it as it is if in doubt.\n\n\
The hotspot keeps its own name '$(hotspot_ssid)' either way." \
        13 74 "$cur" 3>&1 1>&2 2>&3)" || return 0
    new="$(printf '%s' "$new" | tr -d '[:space:]')"
    [ -n "$new" ] || return 0
    [ "$new" = "$cur" ] && return 0

    printf '%s\n' "$new" > /etc/pins/rig-name
    chmod 0644 /etc/pins/rig-name
    if [ -x "$RIG_NAME_CMD" ]; then
        # Normalises (lowercase, [a-z0-9.-], <= 63 chars) and persists.
        name="$("$RIG_NAME_CMD" --ensure 2>/dev/null)"
    fi
    if [ -z "${name:-}" ]; then
        # No pinsdaemon: do the same job locally rather than skipping it.
        name="$(printf '%s' "$new" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9.-' '-' | cut -c1-63)"
        name="${name%%-}"
        printf '%s\n' "$name" > /etc/pins/rig-name
    fi
    # Static, running and hosts entry, in that order. hostnamectl alone is not
    # enough: it can refuse the write, and avahi advertises the RUNNING name.
    hostnamectl set-hostname "$name" >/dev/null 2>&1 || true
    printf '%s\n' "$name" > /etc/hostname
    chmod 0644 /etc/hostname
    [ "$(hostname 2>/dev/null)" = "$name" ] || hostname "$name" 2>/dev/null || true
    if grep -q '^127\.0\.1\.1[[:space:]]' /etc/hosts 2>/dev/null; then
        sed -i "s/^127\.0\.1\.1.*/127.0.1.1 ${name}/" /etc/hosts
    else
        printf '127.0.1.1 %s\n' "$name" >> /etc/hosts
    fi
    systemctl restart avahi-daemon >/dev/null 2>&1 || true
    msgbox "This rig is now called '${name}'.\n\nIt answers to ${name}.local once the network is up." 10 68
}

# --- 5. summary, then get out of the way -------------------------------------
step_summary() {
    local host addrs ssid hotline url_local
    host="$(hostname)"
    addrs="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -v '^$' | paste -sd', ' -)"
    ssid="$(hotspot_ssid)"
    if [ "$HOTSPOT_PW_CHANGED" = "1" ]; then
        hotline="Wi-Fi: ${ssid} (WPA2, the password you just set)"
    else
        hotline="Wi-Fi: ${ssid} (WPA2, the password from the setup guide)"
    fi
    url_local="http://${host}.local:5000"

    if ! whiptail --title "PINS is ready" --msgbox "\
Hostname : ${host}  (${host}.local)\n\
Addresses: ${addrs:-none yet}\n\
${hotline}\n\
$([ -n "$WIFI_JOINED" ] && printf 'Joined   : %s' "$WIFI_JOINED" || printf 'Hotspot stays on until a Wi-Fi network is configured.')\n\
\n\
Open the web interface at\n\
  ${url_local}\n\
  http://10.42.0.1:5000      (when connected to the hotspot)\n\
\n\
The same interface is what the Touch'N'Stars app talks to - point the app\n\
at this device and you are done.\n\
\n\
This setup will not run again." 22 76
    then
        # The closing dialog could not be shown (or was escaped), so the
        # operator has not seen any of this. Leave everything in place and let
        # the next login start over - never sign off work nobody saw.
        flock -u 9
        return 1
    fi

    # Order matters: the flag goes first, then the sudo rule that only existed
    # to start this wizard. Anything that aborts before this point leaves both
    # in place and the wizard runs again at the next login.
    rm -f "$FLAG"
    rm -f "$SUDOERS"
    flock -u 9
}

step_password
step_network
step_rigname
# Non-zero when the closing dialog never made it to the screen: the profile.d
# hook then prints its "run it manually" hint instead of pretending all is well.
step_summary || exit 1
exit 0
