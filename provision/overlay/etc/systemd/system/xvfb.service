[Unit]
# X virtual framebuffer on :99. PHD2 is a GTK application with no headless mode,
# so on an appliance without a desktop it needs a display to attach to.
#
# Enabled by default, exactly like phd2.service (O5): the provisioning seeds a
# minimal ~/.phd2 profile, so PHD2 starts headless instead of blocking on its
# first-run dialog; PINS_ENABLE_PHD2=0 opts out. phd2 pulls this unit in via
# Requires=, so "systemctl enable --now phd2" (which the pinsdaemon sudoers
# whitelist allows the API to run) starts the framebuffer as well without the
# operator having to know about it.
Description=X virtual framebuffer for headless PHD2
After=local-fs.target

[Service]
Type=simple
# Runs as pins, not root: /tmp/.X11-unix is created 1777 by x11-common's
# tmpfiles.d; an unprivileged Xvfb is the standard xvfb-run case. phd2.service
# connects as the same user, so no xauth handover is needed.
User=pins
Group=pins
# -nolisten tcp: nothing outside this machine has any business on :99.
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x800x24 -nolisten tcp
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
