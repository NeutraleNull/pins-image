# Lets the appliance user start the first-run wizard from the profile.d hook
# without a password -- which is the whole point, since the password is exactly
# what the wizard is about to change.
#
# Exactly this one command, not a general NOPASSWD:ALL. The wizard deletes this
# file itself once it has finished (see /usr/lib/pins/firstrun-wizard), so the
# rule does not outlive its purpose.
#
# Installed 0440 root:root. The provisioning script re-applies that mode after
# rolling out the overlay, because git cannot record it.
pins ALL=(root) NOPASSWD: /usr/lib/pins/firstrun-wizard
